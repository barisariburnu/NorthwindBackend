{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=Northwind;Trusted_Connection=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": [
    "http://localhost:3000",
    "http://localhost:4200"
  ],
  "TokenOptions": {
    "Audience": "yourdomain.com",
    "Issuer": "yourdomain.com",
    "AccessTokenExpiration": 10,
    "SecurityKey": "your-very-secure-secret-key-minimum-16-characters"
  }
}
