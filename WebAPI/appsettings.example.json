{
    "ConnectionStrings": {
        "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=Northwind;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;",
        "// Alternative for Windows Authentication": "Server=YOUR_SERVER_NAME;Database=Northwind;Trusted_Connection=true;",
        "// Alternative for LocalDB": "Server=(localdb)\\mssqllocaldb;Database=Northwind;Trusted_Connection=true"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "CorsOrigins": [
        "http://localhost:3000",
        "http://localhost:4200",
        "https://yourfrontend.com"
    ],
    "TokenOptions": {
        "Audience": "yourdomain.com",
        "Issuer": "yourdomain.com",
        "AccessTokenExpiration": 10,
        "SecurityKey": "your-very-secure-secret-key-minimum-16-characters-long"
    }
}